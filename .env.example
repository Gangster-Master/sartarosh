# Telegram bot token from @BotFather (required to run the bot)
BOT_TOKEN=
# Comma-separated Telegram user ids of the owners (env admins; cannot be demoted in the bot)
ADMIN_IDS=
# SQLite file; relative paths are resolved against the project root
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# Directory for bot.lock and backups (relative -> project root)
DATA_DIR=data
# Shop timezone. Use SHOP_TZ, never TZ.
SHOP_TZ=Asia/Tashkent
DEFAULT_LANG=uz
LOG_LEVEL=INFO
#SCHEDULER_TICK_SECONDS=30
#THROTTLE_PER_MINUTE=30
#DB_ECHO=false
# Optional: Redis for FSM storage (otherwise the database is used)
#REDIS_URL=
# --- Telegram Mini App (web view) ---
#WEBAPP_ENABLED=false
#WEBAPP_HOST=127.0.0.1
#WEBAPP_PORT=8080
# Public HTTPS URL that serves the app (reverse proxy or cloudflared tunnel). Empty = buttons hidden.
#WEBAPP_URL=
#WEBAPP_AUTH_MAX_AGE=86400
#WEBAPP_AUTH_MAX_AGE_WRITE=86400
#WEBAPP_TRUST_PROXY=false  # set true behind nginx / Caddy / cloudflared
